{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --prefix cloud --omit=dev --ignore-scripts",
  "buildCommand": "node site/build.mjs",
  "outputDirectory": "site/dist",
  "trailingSlash": true,
  "functions": {
    "api/*.mjs": {
      "maxDuration": 30,
      "includeFiles": "{src/app/**,src/app-index.mjs,src/tools.mjs,src/config.mjs,src/derive.mjs,src/state.mjs,src/redact.mjs,src/secrets.mjs,src/upload.mjs,cloud/src/**,design/tokens.css}"
    }
  },
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "app.imitor.dev"
        }
      ],
      "destination": "/projects/",
      "permanent": false
    },
    {
      "source": "/((?!p/|v1/|login|logout|auth/|projects|static/|api/).+)",
      "has": [
        {
          "type": "host",
          "value": "app.imitor.dev"
        }
      ],
      "destination": "https://imitor.dev/$1",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/zz-probe-c/(.*)",
      "destination": "/api/cloud?__imitor_path=/projects"
    },
    {
      "source": "/zz-probe-d/(.*)",
      "destination": "/api/cloud/?__imitor_path=/projects"
    },
    {
      "source": "/zz-probe-e/:rest*/",
      "destination": "/api/cloud/?__imitor_path=/projects"
    },
    {
      "source": "/zz-probe-a/:rest*",
      "destination": "/api/cloud?__imitor_path=/projects"
    },
    {
      "source": "/zz-probe-b/:rest*",
      "destination": "/api/cloud/?__imitor_path=/projects"
    },
    {
      "source": "/:first(p|v1|login|logout|auth|projects|static)/:rest*",
      "has": [
        {
          "type": "host",
          "value": "app.imitor.dev"
        }
      ],
      "destination": "/api/cloud?__imitor_path=/:first/:rest*"
    },
    {
      "source": "/demo/((?!api/|files/|assets/)[^.]*)",
      "destination": "/demo/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron-retention/",
      "schedule": "17 4 * * *"
    }
  ]
}
