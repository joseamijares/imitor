{
  "name": "imitor",
  "version": "0.1.0",
  "description": "See a React Native / Expo app's UI without a simulator: web-rendered screens in device frames, screenshots, and a report page.",
  "keywords": [
    "react-native",
    "expo",
    "screenshots",
    "preview",
    "visual-review",
    "mcp",
    "ai-agents",
    "playwright",
    "ci",
    "imitation"
  ],
  "homepage": "https://imitor.vercel.app",
  "bugs": {
    "url": "https://github.com/joseamijares/imitor/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joseamijares/imitor.git"
  },
  "license": "MIT",
  "bin": {
    "imitor": "bin/imitor.mjs"
  },
  "main": "src/metro.cjs",
  "exports": {
    ".": "./src/metro.cjs",
    "./metro": "./src/metro.cjs",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "demo": "node demo/build.mjs",
    "site": "node site/build.mjs"
  },
  "dependencies": {
    "sql.js": "^1.13.0"
  },
  "peerDependencies": {
    "playwright": ">=1.45"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  }
}
